.retarget-root {
    flex-grow: 1;
}

#notice {
    margin: 4px 6px 0 6px;
}

#list {
    padding: 4px 2px;
}

/* ---- one path ---- */

.card {
    margin: 4px 6px;
    padding: 6px 8px 4px 8px;
    border-radius: 4px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0.35);
    background-color: rgba(255, 255, 255, 0.04);
}

.card--broken {
    border-left-width: 3px;
    border-left-color: rgb(226, 168, 60);
}

.card--changed {
    border-left-width: 3px;
    border-left-color: rgb(88, 173, 233);
    background-color: rgba(88, 173, 233, 0.08);
}

.card--hover {
    border-color: rgb(88, 173, 233);
    background-color: rgba(88, 173, 233, 0.16);
}

.card__header {
    flex-direction: row;
    align-items: center;
}

.path {
    -unity-font-style: bold;
    white-space: normal;
    flex-shrink: 1;
}

.counts {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.45);
    margin: 1px 0 4px 2px;
}

/* ---- status pill ---- */

.pill {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 1px 5px;
    margin-right: 6px;
    border-radius: 7px;
    color: rgb(24, 24, 24);
    flex-shrink: 0;
}

.pill--ok {
    background-color: rgb(126, 191, 126);
}

.pill--broken {
    background-color: rgb(226, 168, 60);
}

.pill--unknown {
    background-color: rgba(255, 255, 255, 0.28);
    color: rgba(255, 255, 255, 0.85);
}

/* ---- retarget row ---- */

.drop-row {
    flex-direction: row;
    align-items: center;
    margin-top: 2px;
}

.caption {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
    min-width: 72px;
}

.proposal {
    color: rgb(126, 191, 233);
    -unity-font-style: bold;
    margin-left: 6px;
    white-space: normal;
    flex-shrink: 1;
}

.clear {
    width: 18px;
    margin-left: 2px;
    padding: 0;
}

/* ---- suggestions ---- */

.suggestions {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 3px;
}

.chip {
    margin: 2px 4px 2px 0;
    padding: 1px 7px;
    border-radius: 9px;
    font-size: 10px;
}

.chip--complete {
    border-color: rgb(126, 191, 126);
    color: rgb(160, 214, 160);
}

.chip--partial {
    border-color: rgba(255, 255, 255, 0.25);
    color: rgba(255, 255, 255, 0.55);
}

/* ---- bindings ---- */

.details {
    margin-top: 2px;
}

.details > .unity-foldout__toggle > .unity-toggle__input > .unity-text-element {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.5);
}

.clip-row {
    flex-direction: row;
    align-items: center;
    margin-left: 12px;
}

.clip-name {
    font-size: 10px;
    -unity-font-style: bold;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    padding: 0 6px 0 0;
    margin: 0;
    color: rgb(126, 191, 233);
}

.properties {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.45);
    white-space: normal;
    flex-shrink: 1;
}

/* ---- footer ---- */

.footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4px 8px;
    border-top-width: 1px;
    border-top-color: rgba(0, 0, 0, 0.35);
}

.summary {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.6);
    flex-shrink: 1;
    white-space: normal;
}

.apply {
    min-width: 90px;
}

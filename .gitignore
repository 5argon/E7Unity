### Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/
[Mm]emory[Cc]aptures/
[Rr]ecordings/

# Force-commit the package project's tracked folders.
!/src/E7Unity/Assets/**
!/src/E7Unity/Packages/**
!/src/E7Unity/ProjectSettings/**

# Per-machine editor state, not project configuration.
/src/E7Unity/ProjectSettings/PackageManagerSettings.asset
/src/E7Unity/ProjectSettings/SceneTemplateSettings.json

# Ignore .meta only when its asset is also ignored.
!**/[Aa]ssets/**/*.meta

# Keep UPM `~` folders (Documentation~, Samples~).
# Without these, the global gitignore's `*~` rule (Emacs backup files) swallows them whole.
!Documentation~/
!**/Documentation~/
!Samples~/
!**/Samples~/

### Build output
*.apk
*.aab
*.unitypackage

# Legacy Asset Store publish artifacts (generated by pack-assetstore.sh; not needed for UPM publishing).
Documentation~.zip
Documentation~.zip.meta
Samples~.zip
Samples~.zip.meta

